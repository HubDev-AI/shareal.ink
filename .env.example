# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shareal_ink?schema=public"

# ── Redis ─────────────────────────────────────────────────
# BullMQ queue (standard Redis protocol)
REDIS_URL="redis://localhost:6379"

# ── Analytics ─────────────────────────────────────────────
# Plausible domain — omit to disable analytics (NoopAnalytics)
# PLAUSIBLE_DOMAIN=shareal.ink
# Self-hosted Plausible API URL — omit to use plausible.io cloud
# For local Docker: PLAUSIBLE_API_URL=http://localhost:8000/api/event
# PLAUSIBLE_API_URL=

# ── Error Tracking ──────────────────────────────────────
# Sentry DSN — omit to disable error tracking
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=  # CI only — for source map uploads
# SENTRY_ORG=
# SENTRY_PROJECT=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
